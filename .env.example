# 复制本文件为 .env 后修改：cp .env.example .env
# .env 已被 .gitignore 排除，切勿提交到版本库。

# docker-compose 中 Nginx 对外暴露的端口（本地开发端口见下方 CORS 说明，不由此变量控制）。
JIAXIU_WEB_PORT=8080

# 初始账号。仅在账号不存在时用于首次创建；账号建好后修改这两项不会重置已有密码。
# 密码长度需为 12 至 256 个字符，部署时必须替换掉 CHANGE_ME_* 占位值。
JIAXIU_ADMIN_USERNAME=admin
JIAXIU_ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
JIAXIU_CONTRIBUTOR_USERNAME=contributor
JIAXIU_CONTRIBUTOR_INITIAL_PASSWORD=CHANGE_ME_CONTRIBUTOR_PASSWORD

# 使用 HTTPS 上线时保持 true；仅在本机纯 HTTP 验证时改为 false。
JIAXIU_SESSION_COOKIE_SECURE=true

# 浏览器实际访问来源，必须是合法 JSON 数组：
# 每个来源单独加引号、逗号分隔，不要把逗号写进引号里，
# 否则会被解析成单个非法来源，导致全部跨域请求被浏览器拦截。
# 5173 为 scripts/run-local.* 启动的前端端口；8080 为 docker-compose 的 Nginx 端口。
# 若通过局域网 IP 访问前端，需把该来源（如 http://192.168.1.20:5173）一并加入。
JIAXIU_CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# 可选的 OpenAI 兼容模型；三项同时设置后才启用，留空则使用确定性导览。
JIAXIU_MODEL_BASE_URL=
JIAXIU_MODEL_API_KEY=
JIAXIU_MODEL_NAME=gpt-4.1-mini
